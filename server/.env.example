# ----------------------------------------------------------------------------
# Server environment. Copy to `.env` and fill in real values. NEVER commit .env.
# ----------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# Allowed browser origin(s) for CORS + CSRF, comma-separated for multiple
# (e.g. https://istore.app,https://www.istore.app). In production these must be
# real https origins — localhost is rejected at boot.
CLIENT_URL=http://localhost:5173

# Auth — use a long, random string in production (e.g. `openssl rand -base64 48`).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Admin + staff bootstrap credentials (used by the seed script). In production
# these must NOT be the defaults below — the app refuses to boot otherwise.
ADMIN_EMAIL=admin@istore.test
ADMIN_PASSWORD=ChangeMe123!
STAFF_EMAIL=staff@istore.test
STAFF_PASSWORD=StaffPass123!

# Database — a PostgreSQL connection string.
# Free managed options: Neon (https://neon.tech) or Supabase (https://supabase.com).
# 1) Create a free project, 2) copy the connection string here, 3) run migrations.
DATABASE_URL="postgresql://user:password@host:5432/istore?sslmode=require"
