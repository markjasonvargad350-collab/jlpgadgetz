# ============================================================================
#  PRODUCTION environment reference for the iStore API (Render).
#
#  This is a CHECKLIST/REFERENCE — do NOT commit a filled-in copy with real
#  secrets. On Render, set these under the service's "Environment" tab (or via
#  render.yaml). Values marked "REPLACE_…" must be changed before going live.
# ============================================================================

# Must be exactly "production" — enables Secure/SameSite=None cookies, HSTS,
# and the boot-time guards that reject weak/default secrets & passwords.
NODE_ENV=production

# Render injects PORT automatically and the app honors it — leave this UNSET on
# Render. (Only set it if you run the compiled server somewhere without a PORT.)
# PORT=10000

# Deployed frontend origin(s), comma-separated, NO trailing slash, https only.
# Drives BOTH the CORS allowlist and the CSRF Origin allowlist. localhost is
# rejected at boot in production. Include every origin the SPA is served from
# (apex + www + any custom domain). Example:
#   CLIENT_URL=https://your-store.vercel.app,https://www.yourdomain.com
CLIENT_URL=https://your-store.vercel.app

# 48+ random bytes. Generate with:  openssl rand -base64 48
# (On Render, prefer `generateValue: true` in render.yaml so it's never in a file.)
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

# Admin + staff bootstrap accounts, consumed by the seed script. These MUST NOT
# be the dev defaults (ChangeMe123! / StaffPass123!) — production refuses to boot
# if they are. Use strong, unique passwords and store them in a password manager.
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD
STAFF_EMAIL=staff@yourdomain.com
STAFF_PASSWORD=REPLACE_WITH_A_STRONG_STAFF_PASSWORD

# Neon Postgres. Use the DIRECT (non-pooled) connection string and keep
# ?sslmode=require. Neon dashboard → Connection Details → copy. Example:
#   postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Optional: log verbosity (debug|info|warn|error). Defaults to `info` in production.
# LOG_LEVEL=info
