# Base URL of the backend API — including the trailing `/api` path segment.
#
# Development: leave EMPTY to use the Vite dev proxy (requests to /api are
# forwarded to http://localhost:4000 — see vite.config.ts).
#
# Production (Vercel): set to your deployed backend origin PLUS `/api`, e.g.
#   VITE_API_URL=https://istore-api.onrender.com/api
# The client calls bare paths like `/products`, so the `/api` suffix here is
# required (in dev the proxy adds it for you). No trailing slash after `/api`.
VITE_API_URL=
